# GoFI — copy to .env.local and fill in. NEVER commit .env.local.

# ---------------------------------------------------------------------------
# WDK — development wallet (server-only, never exposed to the browser)
# ---------------------------------------------------------------------------
# BIP-39 mnemonic for the shared TESTNET development wallet.
# Generate with:  pnpm wallet:new
# Testnet only. Never put a seed that holds real funds here.
WDK_SEED=""

# Passphrase for the local wdk-cli wallet store (Claude Code MCP).
# Leave empty: `pnpm wdk:setup` generates one and writes it to .env.local.
WDK_CLI_PASSPHRASE=""

# Ethereum Sepolia RPC endpoints, comma-separated. WDK fails over in order.
WDK_EVM_RPC_URLS="https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.gateway.tenderly.co,https://1rpc.io/sepolia"

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""

# Publishable key (sb_publishable_...). Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Secret key (sb_secret_...). Bypasses RLS — server only, NEVER NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# AI (used from BLOCK 4 onwards)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
